#!/usr/bin/env python3
"""The cases of tools/ignore-sites: scratch crates with their test lists, a
site listed and runnable, a site ignored under both feature sets, a site the
sqlite build does not list, the attribute across lines and on one, a usage
fault on an empty list, and the full path (#656): a dead site sharing its
name with a running test, the #[path] chain of the ladder fixtures, inline
mods, the remote-only job's sites, an attribute in a comment or a string,
and a file no crate reaches; and each site against its own binary's list
(#693): a dead site in a test binary whose path a live lib test has, a live
and a dead site in one binary, cargo's coloured `Running` lines, and a list
with no `Running` line.

  tools/ignore-sites-test
"""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCRIPT = HERE / "ignore-sites"

CONFINED = '''#[tokio::test]
#[cfg_attr(
    not(feature = "sqlite"),
    ignore = "runs in the sqlite Test Suite job (#651)"
)]
async fn {name}() {{}}
'''
ONE_LINE = '#[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n#[test]\nfn {name}() {{}}\n'
BOTH = '#[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n#[ignore]\n#[test]\nfn {name}() {{}}\n'
PLAIN = '#[test]\nfn {name}() {{}}\n#[ignore]\n#[test]\nfn live_only() {{}}\n'
DEAD = ('#[cfg(not(feature = "sqlite"))]\n'
        '#[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n#[test]\nfn {name}() {{}}\n')
REMOTE = '#[cfg_attr(feature = "sqlite", ignore = "x")]\n#[test]\nfn {name}() {{}}\n'
QUOTED = ('// #[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n'
          'const S: &str = r#"#[cfg_attr(not(feature = "sqlite"), ignore)] {{"#;\n'
          "const C: char = '{{';\n#[test]\nfn {name}() {{}}\n")

passed = 0
failed = 0


def check(name, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
        print(f"ok   {name}")
    else:
        failed += 1
        print(f"FAIL {name} {detail}")


def listing(lists, colour):
    """Cargo's `--list` output with its stderr: a list of tests is the lib's,
    a dict maps each crate root to its tests, None is a bare list."""
    if lists is None:
        return ""
    if not isinstance(lists, dict):
        lists = {"src/lib.rs": lists}
    on, off = ("\x1b[1m\x1b[92m", "\x1b[0m") if colour else ("", "")
    out = [f"{on}    Finished{off} `test` profile [unoptimized] target(s) in 0.30s\n"]
    for crate, tests in lists.items():
        unit = "unittests " if crate.startswith("src/") else ""
        out.append(f"{on}     Running{off} {unit}{crate} (target/debug/deps/x-0)\n")
        out += [f"{t}: test\n" for t in tests]
        out.append(f"\n{len(tests)} tests, 0 benchmarks\n")
    return "".join(out)


def run(files, every, ignored, job=None, colour=False):
    """The guard's exit and output over a scratch crate and its two lists."""
    tmp = Path(tempfile.mkdtemp(prefix="ignore-sites-test-", dir=os.environ.get("TMPDIR")))
    try:
        for rel, text in files.items():
            (tmp / rel).parent.mkdir(parents=True, exist_ok=True)
            (tmp / rel).write_text(text)
        (tmp / "src").mkdir(exist_ok=True)
        (tmp / "tests").mkdir(exist_ok=True)
        if every is None:
            (tmp / "all.txt").write_text("a::slow: test\n1 tests, 0 benchmarks\n")
        else:
            (tmp / "all.txt").write_text(listing(every, colour))
        (tmp / "ignored.txt").write_text(listing(ignored, colour))
        argv = [sys.executable, str(SCRIPT), "--root", str(tmp),
                "--all", str(tmp / "all.txt"), "--ignored", str(tmp / "ignored.txt")]
        if job:
            argv += ["--job", job]
        out = subprocess.run(argv, capture_output=True, text=True)
        return out.returncode, out.stdout + out.stderr
    finally:
        shutil.rmtree(tmp)


IN_TESTS = "#[cfg(test)]\nmod tests {{\n" + CONFINED + "}}\n"

code, out = run({"src/lib.rs": "mod a;\n", "src/a.rs": IN_TESTS.format(name="slow_one")},
                ["a::tests::slow_one", "a::tests::other"], [])
check("a confined site the sqlite build lists and runs is green",
      code == 0 and "1 sites, 0 red" in out and "ok   src/a.rs:4 a::tests::slow_one" in out,
      out)

code, out = run({"tests/fixtures/main.rs": "mod b;\n",
                 "tests/fixtures/b.rs": ONE_LINE.format(name="cut")},
                {"tests/fixtures/main.rs": ["b::cut"]}, [])
check("the attribute on one line, in a test target's module, is a site",
      code == 0 and "ok   tests/fixtures/b.rs:1 b::cut" in out, out)

code, out = run({"src/lib.rs": "mod a;\nmod c;\n", "src/a.rs": CONFINED.format(name="slow_one"),
                 "src/c.rs": BOTH.format(name="planted")},
                ["a::slow_one", "c::planted"], ["c::planted"])
check("a site ignored under both feature sets is red",
      code == 1 and "FAIL src/c.rs:1 planted: ignored in the sqlite build's list too" in out,
      out)

code, out = run({"src/lib.rs": "mod a;\n", "src/a.rs": CONFINED.format(name="slow_one")},
                ["a::other"], [])
check("a site the sqlite build does not list is red",
      code == 1 and "not in the sqlite build's list as a::slow_one" in out, out)

code, out = run({"src/lib.rs": "mod d;\n", "src/d.rs": PLAIN.format(name="plain")},
                ["d::plain", "d::live_only"], ["d::live_only"])
check("a plain #[ignore] is not a site", code == 0 and "0 sites, 0 red" in out, out)

code, out = run({"src/lib.rs": "mod a;\n", "src/a.rs": CONFINED.format(name="slow_one")}, [], [])
check("an empty sqlite list is a usage fault", code == 2, out)

# The #655 read's plant: a dead test under #[cfg(not(feature = "sqlite"))]
# named as a running test in another module.
code, out = run({"src/lib.rs": "mod ladders;\nmod rule_28;\n",
                 "src/ladders.rs": CONFINED.format(name="replay"),
                 "src/rule_28.rs": DEAD.format(name="replay")},
                ["ladders::replay"], [])
check("a dead site sharing its name with a running test is red",
      code == 1 and "ok   src/ladders.rs:2 ladders::replay" in out
      and "FAIL src/rule_28.rs:2 replay: not in the sqlite build's list as rule_28::replay" in out,
      out)

# The ladder fixtures' chain: a #[path] up out of src/ and two more beside it,
# a mod.rs owner and a non-mod-rs owner's directory.
code, out = run({"src/lib.rs": "pub mod services;\n",
                 "src/services/mod.rs": "pub mod services;\n",
                 "src/services/services.rs": ('#[cfg(test)]\n#[path = "host.rs"]\nmod host;\n'
                                              "mod inner;\n"),
                 "src/services/services/inner.rs": ONE_LINE.format(name="inner_one"),
                 "src/services/host.rs": '#[path = "../../tests/fixtures/ladders.rs"]\nmod ladders;\n',
                 "tests/fixtures/ladders.rs": '#[path = "ladder_cut.rs"]\nmod cut;\n',
                 "tests/fixtures/ladder_cut.rs": CONFINED.format(name="cut_short")},
                ["services::services::host::ladders::cut::cut_short",
                 "services::services::inner::inner_one"], [])
check("a site reached through #[path] mods has its module path",
      code == 0 and "2 sites, 0 red" in out
      and "services::services::host::ladders::cut::cut_short" in out, out)

code, out = run({"src/lib.rs": "mod a {\n    pub mod b {\n" + ONE_LINE.format(name="deep")
                 + "    }\n}\nmod c;\n",
                 "src/c.rs": "mod t {\n" + ONE_LINE.format(name="deep") + "}\n"},
                ["a::b::deep"], [])
check("inline mods are in the path, and close where their braces do",
      code == 1 and "ok   src/lib.rs:3 a::b::deep" in out
      and "not in the sqlite build's list as c::t::deep" in out, out)

code, out = run({"src/lib.rs": "mod a;\nmod r;\n", "src/a.rs": CONFINED.format(name="slow_one"),
                 "src/r.rs": REMOTE.format(name="remote_one")},
                ["r::remote_one"], [], job="remote")
check("the remote-only job's sites are its own, checked against its list",
      code == 0 and "remote job, 1 sites, 0 red" in out and "ok   src/r.rs:1 r::remote_one" in out,
      out)

code, out = run({"src/lib.rs": "mod r;\n", "src/r.rs": REMOTE.format(name="remote_one")},
                ["r::other"], [], job="remote")
check("a remote-only site its build does not list is red",
      code == 1 and "not in the remote-only build's list as r::remote_one" in out, out)

code, out = run({"src/lib.rs": "mod q;\n", "src/q.rs": QUOTED.format(name="q_one")},
                ["q::q_one"], [])
check("the attribute in a comment or a string is not a site, nor a brace in a char",
      code == 0 and "0 sites, 0 red" in out, out)

code, out = run({"src/lib.rs": "\n", "src/orphan.rs": ONE_LINE.format(name="lost")},
                ["lost"], [])
check("a site in a file no crate reaches is red",
      code == 1 and "no crate's module tree reaches the file" in out, out)

# #693: the #691 read's plant, a dead a::slow in a test binary beside a live
# a::slow in the lib; one set of every binary's paths read both as ok.
CROSS = {"src/lib.rs": "mod a;\n", "src/a.rs": ONE_LINE.format(name="slow"),
         "tests/t/main.rs": "mod a;\n", "tests/t/a.rs": DEAD.format(name="slow")}
code, out = run(CROSS, {"src/lib.rs": ["a::slow"], "tests/t/main.rs": []}, {})
check("a dead site whose path a live test of another binary has is red",
      code == 1 and "ok   src/a.rs:1 a::slow (src/lib.rs)" in out
      and "FAIL tests/t/a.rs:2 slow: not in the sqlite build's list as"
      " a::slow (tests/t/main.rs)" in out and "2 sites, 1 red" in out, out)

code, out = run({"tests/t.rs": "mod a;\nmod b;\n", "tests/a.rs": ONE_LINE.format(name="live"),
                 "tests/b.rs": DEAD.format(name="dead")},
                {"src/lib.rs": ["b::dead"], "tests/t.rs": ["a::live"], "tests/a.rs": [],
                 "tests/b.rs": []}, {})
check("a live and a dead site in one binary: the dead one alone is red",
      code == 1 and "ok   tests/a.rs:1 a::live (tests/t.rs)" in out
      and "FAIL tests/b.rs:2 dead: not in the sqlite build's list as dead (tests/b.rs)"
      " or b::dead (tests/t.rs)" in out and "2 sites, 1 red" in out, out)

code, out = run({"src/lib.rs": "mod a;\n", "src/a.rs": ONE_LINE.format(name="slow"),
                 "tests/u.rs": "#[test]\nfn u() {}\n"},
                {"src/lib.rs": ["a::slow"], "tests/u.rs": ["u"]},
                {"src/lib.rs": [], "tests/u.rs": []}, colour=True)
check("cargo's coloured Running lines name the binaries",
      code == 0 and "ok   src/a.rs:1 a::slow (src/lib.rs)" in out, out)

code, out = run({"src/lib.rs": "mod a;\n", "src/a.rs": ONE_LINE.format(name="slow")}, None, {})
check("a list with a test before any Running line is a usage fault",
      code == 2 and "before any Running line" in out, out)

print(f"ignore-sites-test: {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
