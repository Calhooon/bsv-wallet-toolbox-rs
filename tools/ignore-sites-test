#!/usr/bin/env python3
"""The cases of tools/ignore-sites: scratch trees with their test lists, a
site listed and runnable, a site ignored under both feature sets, a site the
sqlite build does not list, the attribute across lines and on one, and a
usage fault on an empty list.

  tools/ignore-sites-test
"""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCRIPT = HERE / "ignore-sites"

CONFINED = '''#[tokio::test]
#[cfg_attr(
    not(feature = "sqlite"),
    ignore = "runs in the sqlite Test Suite job (#651)"
)]
async fn {name}() {{}}
'''
ONE_LINE = '#[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n#[test]\nfn {name}() {{}}\n'
BOTH = '#[cfg_attr(not(feature = "sqlite"), ignore = "x")]\n#[ignore]\n#[test]\nfn {name}() {{}}\n'
PLAIN = '#[test]\nfn {name}() {{}}\n#[ignore]\n#[test]\nfn live_only() {{}}\n'

passed = 0
failed = 0


def check(name, ok, detail=""):
    global passed, failed
    if ok:
        passed += 1
        print(f"ok   {name}")
    else:
        failed += 1
        print(f"FAIL {name} {detail}")


def run(files, every, ignored):
    """The guard's exit and output over a scratch tree and its two lists."""
    tmp = Path(tempfile.mkdtemp(prefix="ignore-sites-test-", dir=os.environ.get("TMPDIR")))
    try:
        for rel, text in files.items():
            (tmp / rel).parent.mkdir(parents=True, exist_ok=True)
            (tmp / rel).write_text(text)
        (tmp / "src").mkdir(exist_ok=True)
        (tmp / "tests").mkdir(exist_ok=True)
        (tmp / "all.txt").write_text("".join(f"{t}: test\n" for t in every)
                                     + f"{len(every)} tests, 0 benchmarks\n")
        (tmp / "ignored.txt").write_text("".join(f"{t}: test\n" for t in ignored))
        out = subprocess.run([sys.executable, str(SCRIPT), "--root", str(tmp),
                              "--all", str(tmp / "all.txt"),
                              "--ignored", str(tmp / "ignored.txt")],
                             capture_output=True, text=True)
        return out.returncode, out.stdout + out.stderr
    finally:
        shutil.rmtree(tmp)


code, out = run({"src/a.rs": CONFINED.format(name="slow_one")},
                ["a::tests::slow_one", "a::tests::other"], [])
check("a confined site the sqlite build lists and runs is green",
      code == 0 and "1 sites, 0 red" in out, out)

code, out = run({"tests/fixtures/b.rs": ONE_LINE.format(name="cut")},
                ["services::ladders::cut::cut"], [])
check("the attribute on one line, under tests/, is a site", code == 0 and "ok   " in out, out)

code, out = run({"src/a.rs": CONFINED.format(name="slow_one"),
                 "src/c.rs": BOTH.format(name="planted")},
                ["a::slow_one", "c::planted"], ["c::planted"])
check("a site ignored under both feature sets is red",
      code == 1 and "FAIL src/c.rs:1 planted: ignored in the sqlite build too" in out, out)

code, out = run({"src/a.rs": CONFINED.format(name="slow_one")}, ["a::other"], [])
check("a site the sqlite build does not list is red",
      code == 1 and "not in the sqlite build's list" in out, out)

code, out = run({"src/d.rs": PLAIN.format(name="plain")}, ["d::plain", "d::live_only"],
                ["d::live_only"])
check("a plain #[ignore] is not a site", code == 0 and "0 sites, 0 red" in out, out)

code, out = run({"src/a.rs": CONFINED.format(name="slow_one")}, [], [])
check("an empty sqlite list is a usage fault", code == 2, out)

print(f"ignore-sites-test: {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
