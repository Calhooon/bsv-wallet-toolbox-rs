#!/usr/bin/env python3
"""No test confined to one feature set is ignored in every job (#651, #656).

A test that carries `#[cfg_attr(not(feature = "sqlite"), ignore = ...)]`
(the ladder cut test of #634, the four services tests of #651) leaves the
remote-only job and runs in the sqlite Test Suite job; one that carries
`#[cfg_attr(feature = "sqlite", ignore = ...)]` (none yet) would run in the
remote-only job alone. Each Test Suite job runs this guard on its own test
lists (`--job`): it reads the job's sites from the sources and refuses a
site the job's build does not list or lists as ignored, so a site whose
test is ignored there too (a second `ignore`, a predicate true under both)
or compiled out there (a `#[cfg]` on the test) is red rather than a test no
job runs.

  # the sqlite Test Suite job, after its two builds
  { cargo test --lib --features sqlite,remote -- --list
    cargo test --test '*' --features sqlite,remote,bench-support -- --list; } > all.txt 2>&1
  { ... -- --list --ignored; } > ignored.txt 2>&1
  tools/ignore-sites --job sqlite --all all.txt --ignored ignored.txt [--root DIR]

  # the remote-only job, after its build
  cargo test --lib --tests --no-default-features --features remote -- --list > all.txt 2>&1
  ... -- --list --ignored > ignored.txt 2>&1
  tools/ignore-sites --job remote --all all.txt --ignored ignored.txt

The lists are cargo's output with its stderr: a `Running` line (colour
codes dropped) names a test binary by its crate root (`unittests
src/lib.rs`, `tests/<name>.rs`, `tests/<name>/main.rs`), and libtest's
`--list` lines after it (`path::name: test`) are that binary's tests; a
test line before any `Running` line is a usage fault. A site matches a test
of its own binary by its full path: the module path of its file, resolved
from each crate root the lists name through each `mod` and `#[path]`, then
the inline `mod` blocks around it, then the function's name. A test of the
same path in another binary is not the site's (#693: a dead `a::slow` under
`tests/t/` beside a live `a::slow` in the lib), nor one of the same name
elsewhere (the #655 read: a dead `ladder_fixtures_replay` under
`#[cfg(not(feature = "sqlite"))]` passed a guard matching on the name
alone). A file one binary reaches through `#[path]` (the ladder fixtures
under tests/fixtures/, reached from the lib) is matched in each binary that
reaches it. The .rs files under src/ and tests/ are scanned; benches/ and
examples/ are not, since neither job's lists build them as tests. Exit 0
when every site is listed and none is ignored; 1 otherwise; 2 on a usage
fault.

A site is an outer `#[cfg_attr(PREDICATE, ATTR, ...)]` whose list holds
`ignore` (bare or `ignore = "..."`, in any place of the list, a nested
`cfg_attr(Q, ..., ignore)` read as `all(PREDICATE, Q)`), and whose
predicate is false under the job's features and true under the other
job's: the test is confined to the job. The predicate is parsed, spacing
and line breaks aside: `feature = "..."` leaves under `any`, `all` and
`not`, and `test` (true: every list is a test build). The jobs' features
are the ones their builds turn on: the sqlite job `sqlite`, `remote` and
`bench-support` (the integration build's; its lib build has no
`bench-support`, which its list shows), the remote-only job `remote`. Not
a site: a plain `#[ignore]`; a `cfg_attr` with no `ignore` in its list
(`cfg_attr(not(feature = "sqlite"), tokio::test)`); a predicate the same
in both jobs (`feature = "mysql"`, false in both, runs in both; one true in
both is a plain `#[ignore]` by another spelling); a predicate holding any
other leaf (`unix`, `target_os = "..."`) whose value decides it, since the
guard cannot say where it holds; and the attribute in a comment or a
string.
"""

import argparse
import re
import sys
from collections import deque
from pathlib import Path

# The features each job's builds turn on, and the job a site is ignored in.
JOB_FEATURES = {"sqlite": {"sqlite", "remote", "bench-support"}, "remote": {"remote"}}
OTHER_JOB = {"sqlite": "remote", "remote": "sqlite"}
JOB_BUILD = {"sqlite": "the sqlite build's", "remote": "the remote-only build's"}


def lex(text):
    """Rust tokens as (kind, value, offset): kind "id", "str" or "p" (one
    punctuation character); comments, char literals and lifetimes dropped."""
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c.isspace():
            i += 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            depth, i = 1, i + 2
            while i < n and depth:
                if text.startswith("/*", i):
                    depth, i = depth + 1, i + 2
                elif text.startswith("*/", i):
                    depth, i = depth - 1, i + 2
                else:
                    i += 1
        elif c in "rbc" and _raw_or_byte(text, i):
            start = i
            i, value = _string(text, i)
            yield ("str", value, start)
        elif c == '"':
            start = i
            i, value = _string(text, i)
            yield ("str", value, start)
        elif c == "'":
            if i + 1 < n and text[i + 1] == "\\":
                j = text.find("'", i + 2)
                i = n if j < 0 else j + 1
            elif i + 2 < n and text[i + 2] == "'":
                i += 3
            else:
                i += 1
                while i < n and (text[i].isalnum() or text[i] == "_"):
                    i += 1
        elif c.isalpha() or c == "_":
            start = i
            while i < n and (text[i].isalnum() or text[i] == "_"):
                i += 1
            yield ("id", text[start:i], start)
        elif c.isdigit():
            while i < n and (text[i].isalnum() or text[i] == "_"):
                i += 1
        else:
            yield ("p", c, i)
            i += 1


def _raw_or_byte(text, i):
    """A string literal's prefix (r", r#", b", br", c", cr) starts at i."""
    j = i
    if text[j] in "bc":
        j += 1
    if j < len(text) and text[j] == "r":
        j += 1
        while j < len(text) and text[j] == "#":
            j += 1
    return j > i and j < len(text) and text[j] == '"' and (
        i == 0 or not (text[i - 1].isalnum() or text[i - 1] == "_"))


def _string(text, i):
    """The end offset and value of the string literal starting at i."""
    n = len(text)
    while text[i] in "bc":
        i += 1
    if text[i] == "r":
        i += 1
        hashes = 0
        while text[i] == "#":
            hashes, i = hashes + 1, i + 1
        close = '"' + "#" * hashes
        j = text.find(close, i + 1)
        j = n if j < 0 else j
        return j + len(close), text[i + 1:j]
    j, out = i + 1, []
    while j < n and text[j] != '"':
        if text[j] == "\\":
            j += 1
        out.append(text[j] if j < n else "")
        j += 1
    return j + 1, "".join(out)


def _match(tokens, k, pattern):
    """The tokens from k begin with the pattern."""
    for off, want in enumerate(pattern):
        if k + off >= len(tokens):
            return False
        kind, value, _ = tokens[k + off]
        if isinstance(want, tuple):
            if (kind, value) != want:
                return False
        elif kind == "str" or value != want:
            return False
    return True


def _split(tokens):
    """A token run's comma-separated items at its own depth."""
    items, item, depth = [], [], 0
    for tok in tokens:
        if tok[0] == "p" and tok[1] in "([{":
            depth += 1
        elif tok[0] == "p" and tok[1] in ")]}":
            depth -= 1
        if not depth and tok[:2] == ("p", ","):
            items.append(item)
            item = []
        else:
            item.append(tok)
    if item:
        items.append(item)
    return items


def _call(tokens):
    """(name, the tokens inside its parentheses) for `name(...)`, else None."""
    if len(tokens) >= 3 and tokens[0][0] == "id" and tokens[1][:2] == ("p", "(") \
            and tokens[-1][:2] == ("p", ")"):
        return tokens[0][1], tokens[2:-1]
    return None


def predicate(tokens):
    """A cfg predicate's tree: ("feature", name), ("test",), ("any" or
    "all", [trees]), ("not", tree), or ("other",) for any other leaf."""
    kinds = [tok[:2] for tok in tokens]
    if len(kinds) == 3 and kinds[0] == ("id", "feature") and kinds[1] == ("p", "=") \
            and kinds[2][0] == "str":
        return ("feature", kinds[2][1])
    if kinds == [("id", "test")]:
        return ("test",)
    call = _call(tokens)
    if call and call[0] in ("any", "all"):
        return (call[0], [predicate(item) for item in _split(call[1])])
    if call and call[0] == "not" and len(_split(call[1])) == 1:
        return ("not", predicate(_split(call[1])[0]))
    return ("other",)


def holds(tree, features):
    """The predicate's value with these features on: True, False, or None
    where an other leaf decides it."""
    kind = tree[0]
    if kind == "feature":
        return tree[1] in features
    if kind == "test":
        return True
    if kind == "not":
        value = holds(tree[1], features)
        return None if value is None else not value
    if kind in ("any", "all"):
        values = [holds(t, features) for t in tree[1]]
        decides = kind == "any"
        if decides in values:
            return decides
        return None if None in values else not decides
    return None


def ignored_when(tokens):
    """The predicate under which a `cfg_attr` attribute's tokens apply
    `ignore`, a nested one's folded in with `all`; None if they apply none."""
    call = _call(tokens)
    if not call or call[0] != "cfg_attr":
        return None
    items = _split(call[1])
    if len(items) < 2:
        return None
    pred = predicate(items[0])
    for attr in items[1:]:
        if not attr:
            continue
        if attr[0][:2] == ("id", "ignore") and (len(attr) == 1 or attr[1][:2] == ("p", "=")):
            return pred
        inner = ignored_when(attr)
        if inner is not None:
            return ("all", [pred, inner])
    return None


def is_site(tokens, job):
    """An attribute's tokens make a site of the job: ignored in the other
    job, not in this one."""
    when = ignored_when(tokens)
    return when is not None and holds(when, JOB_FEATURES[job]) is False \
        and holds(when, JOB_FEATURES[OTHER_JOB[job]]) is True


def scan(text, job):
    """A file's out-of-line mods (name, #[path] or None, inline mods around
    it) and its job's sites (line, inline mods around it, fn name or None)."""
    tokens = list(lex(text))
    mods, sites = [], []
    stack = []          # per open brace: the inline mod's name, or None
    path_attr = None    # the #[path] since the last item boundary
    k = 0
    while k < len(tokens):
        kind, value, offset = tokens[k]
        if kind == "p" and value == "#" and k + 1 < len(tokens) \
                and tokens[k + 1][1] == "[":
            # An outer attribute: its tokens up to the matching bracket.
            depth, j = 0, k + 1
            while j < len(tokens):
                if tokens[j][0] == "p" and tokens[j][1] == "[":
                    depth += 1
                elif tokens[j][0] == "p" and tokens[j][1] == "]":
                    depth -= 1
                    if not depth:
                        break
                j += 1
            if _match(tokens, k + 2, ["path", "="]) and k + 4 < len(tokens) \
                    and tokens[k + 4][0] == "str":
                path_attr = tokens[k + 4][1]
            if is_site(tokens[k + 2:j], job):
                name = None
                for f in range(j + 1, len(tokens) - 1):
                    if tokens[f][:2] == ("id", "fn") and tokens[f + 1][0] == "id":
                        name = tokens[f + 1][1]
                        break
                line = text.count("\n", 0, offset) + 1
                inline = tuple(m for m in stack if m is not None)
                sites.append((line, inline, name))
            k = j + 1
            continue
        if kind == "id" and value == "mod" and k + 2 < len(tokens) \
                and tokens[k + 1][0] == "id" and tokens[k + 2][0] == "p":
            name, after = tokens[k + 1][1], tokens[k + 2][1]
            if after == ";":
                mods.append((name, path_attr,
                             tuple(m for m in stack if m is not None)))
                path_attr = None
                k += 3
                continue
            if after == "{":
                stack.append(name)
                path_attr = None
                k += 3
                continue
        if kind == "p" and value == "{":
            stack.append(None)
            path_attr = None
        elif kind == "p" and value == "}":
            if stack:
                stack.pop()
            path_attr = None
        elif kind == "p" and value == ";":
            path_attr = None
        k += 1
    return mods, sites


def module_paths(roots, job):
    """Each reached file's (crate root, module path) pairs, one per way a
    crate reaches it, and its job's sites."""
    # (file, crate root, module path, its children's directory)
    queue = deque((p, p, (), p.parent) for p in roots if p.is_file())
    paths, scanned, seen = {}, {}, set()
    while queue:
        path, croot, mpath, owner = queue.popleft()
        if (path, croot, mpath) in seen:
            continue
        seen.add((path, croot, mpath))
        paths.setdefault(path, set()).add((croot, mpath))
        if path not in scanned:
            scanned[path] = scan(path.read_text(), job)
        for name, attr, inline in scanned[path][0]:
            if attr is not None:
                base = owner.joinpath(*inline) if inline else path.parent
                child = (base / attr).resolve()
                queue.append((child, croot, mpath + inline + (name,), child.parent))
                continue
            base = owner.joinpath(*inline)
            for child, child_owner in ((base / f"{name}.rs", base / name),
                                       (base / name / "mod.rs", base / name)):
                if child.is_file():
                    queue.append((child.resolve(), croot, mpath + inline + (name,),
                                  child_owner.resolve()))
                    break
    return paths, scanned


def all_sites(root, roots, job):
    """Each site's (path, line, (crate root, full path) pairs, fn name), in
    path order: every .rs under src/ and tests/, a file none of the crate
    roots reaches with no pair."""
    paths, scanned = module_paths(roots, job)
    found = []
    for top in ("src", "tests"):
        for path in sorted((root / top).rglob("*.rs")):
            real = path.resolve()
            if real in scanned:
                file_sites = scanned[real][1]
            else:
                file_sites = scan(path.read_text(), job)[1]
            for line, inline, name in file_sites:
                full = sorted((c, "::".join(m + inline + (name,)))
                              for c, m in paths.get(real, ())) if name else []
                found.append((path.relative_to(root), line, full, name))
    return found


COLOUR = re.compile(r"\x1b\[[0-9;]*m")
RUNNING = re.compile(r"^\s*Running (?:unittests )?(\S+\.rs) \(")


def listed(path, root):
    """Each binary's tests in a `--list` file with cargo's stderr: its crate
    root, resolved from root, to the full paths of its tests; None when a
    test line comes before any `Running` line."""
    binaries, tests = {}, None
    for line in Path(path).read_text().splitlines():
        line = COLOUR.sub("", line)
        head = RUNNING.match(line)
        if head:
            tests = binaries.setdefault((root / head.group(1)).resolve(), set())
        elif line.endswith(": test"):
            if tests is None:
                return None
            tests.add(line[: -len(": test")])
    return binaries


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--job", choices=sorted(JOB_FEATURES), default="sqlite",
                    help="the job whose sites and lists these are")
    ap.add_argument("--all", required=True, help="the job's builds' --list")
    ap.add_argument("--ignored", required=True, help="their --list --ignored")
    ap.add_argument("--root", default=Path(__file__).resolve().parent.parent,
                    type=Path)
    args = ap.parse_args()

    root = args.root.resolve()
    every, ignored = listed(args.all, root), listed(args.ignored, root)
    for given, lists in ((args.all, every), (args.ignored, ignored)):
        if lists is None:
            print(f"ignore-sites: {given} has a test before any Running line:"
                  " list with cargo's stderr (2>&1)", file=sys.stderr)
            return 2
    if not any(every.values()):
        print(f"ignore-sites: {args.all} lists no test", file=sys.stderr)
        return 2
    build = JOB_BUILD[args.job]
    red = 0
    found = all_sites(root, sorted(every), args.job)

    def named(pair):
        crate, test = pair
        return f"{test} ({crate.relative_to(root) if crate.is_relative_to(root) else crate})"

    for path, line, full, name in found:
        where = f"{path}:{line}"
        runs = [(c, p) for c, p in full
                if p in every[c] and p not in ignored.get(c, ())]
        if name is None:
            verdict = "no fn after the attribute"
        elif not full:
            verdict = "no crate's module tree reaches the file"
        elif runs:
            print(f"ok   {where} {named(runs[0])}")
            continue
        elif any(p in every[c] for c, p in full):
            verdict = f"ignored in {build} list too: no job runs it"
        else:
            verdict = f"not in {build} list as {' or '.join(map(named, full))}"
        red += 1
        print(f"FAIL {where} {name or '?'}: {verdict}")
    print(f"ignore-sites: {args.job} job, {len(found)} sites, {red} red")
    return 1 if red else 0


if __name__ == "__main__":
    sys.exit(main())
